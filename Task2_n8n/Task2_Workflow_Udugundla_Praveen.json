{
  "name": "Task 2 - Hacker News Morning Brief",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://hacker-news.firebaseio.com/v0/topstories.json",
        "options": {}
      },
      "id": "2",
      "name": "Get Top Stories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const body = $json;\nif (!Array.isArray(body)) {\n  return [{ json: { workflowError: true, stage: 'topstories', message: 'Hacker News returned an unexpected response.' } }];\n}\nreturn body.slice(0, 5).map((id, index) => ({\n  json: { rank: index + 1, id }\n}));"
      },
      "id": "3",
      "name": "Select Top 5",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://hacker-news.firebaseio.com/v0/item/{{$json.id}}.json",
        "options": {}
      },
      "id": "4",
      "name": "Enrich Story Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "top-error",
              "leftValue": "={{ $json.workflowError || $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "12",
      "name": "IF Top API Error",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        450,
        520
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "score-check",
              "leftValue": "={{ Number($json.score || 0) }}",
              "rightValue": 100,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "5",
      "name": "IF Score >= 100",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "detail-error",
              "leftValue": "={{ $json.error || $json.workflowError }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "13",
      "name": "IF Enrichment Error",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $json;\nreturn [{ json: {\n  ...d,\n  priority: 'HIGH',\n  title: d.title || '(untitled)',\n  url: d.url || `https://news.ycombinator.com/item?id=${d.id}`\n} }];"
      },
      "id": "6",
      "name": "Mark High Priority",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1130,
        210
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $json;\nreturn [{ json: {\n  ...d,\n  priority: 'NORMAL',\n  title: d.title || '(untitled)',\n  url: d.url || `https://news.ycombinator.com/item?id=${d.id}`\n} }];"
      },
      "id": "7",
      "name": "Mark Normal Priority",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1130,
        390
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst lines = items.map((item, i) => {\n  const d = item.json;\n  return `${i + 1}. [${d.priority || 'ERROR'}] ${d.title || d.message || 'Unknown item'}${d.url ? `\\n   ${d.url}` : ''}${d.score != null ? `\\n   Score: ${d.score}` : ''}`;\n});\nconst content = `**Hacker News Morning Brief**\\n\\n${lines.join('\\n\\n')}`;\nreturn [{ json: { content: content.slice(0, 1900), itemCount: items.length } }];"
      },
      "id": "8",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1370,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#morning-brief"
        },
        "messageType": "text",
        "text": "={{ $json.content }}",
        "otherOptions": {}
      },
      "id": "9",
      "name": "Send Digest to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.4,
      "position": [
        1610,
        300
      ],
      "credentials": {
        "slackApi": {
          "id": "",
          "name": "Slack API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { content: `\u26a0\ufe0f Workflow/API error while building the Hacker News digest.\\nStage: ${$json.stage || 'unknown'}\\nMessage: ${$json.message || $json.error || 'Unexpected API response'}` } }];"
      },
      "id": "10",
      "name": "Build Fallback Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        560
      ]
    },
